# AI chatbot (Groq first, then Gemini, then OpenRouter)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_2=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Contact form (Resend first, Gmail if Resend fails)
RESEND_API_KEY=
EMAIL_USER=
EMAIL_APP_PASSWORD=
CONTACT_TO=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# GitHub activity section (read-only token)
GITHUB_TOKEN=

# Full resume (with phone) for "email me the resume"; a private direct-download PDF link.
# Without it, the public phone-free /resume.pdf is sent.
RESUME_FULL_URL=
